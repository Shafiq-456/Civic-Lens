# ──────────────────────────────────────────────────────────────────────────────
# CIVIC LENZ — Environment Variables Template
# Copy this file to .env.local for local development.
# In production/staging (Netlify / Supabase), configure these in your deployment dashboard.
# NEVER commit .env, .env.local, or .env.staging to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database Configuration ───────────────────────────────────────────────────
# Local Development: Defaults to SQLite (db/custom.db).
DATABASE_URL="file:../db/custom.db"

# Netlify Production & Staging:
# CIVIC LENZ utilizes Supabase PostgreSQL in production and staging environments.
# Netlify ephemeral serverless functions do NOT persist local SQLite databases.
# Set your pooled PostgreSQL connection string from Supabase (port 6543):
POSTGRES_PRISMA_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Groq API (Markus Civic AI Assistant) ──────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# ── Supabase (PostgreSQL — staging or production) ─────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# !! SERVER-SIDE ONLY — Never expose this in the browser or in NEXT_PUBLIC_ vars
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# ── Administrative Secret Key ─────────────────────────────────────────────────
# Server-side key for trusted server-to-server operations and API authorization
ADMIN_SECRET_KEY="your-admin-secret-key-here"
