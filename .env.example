# ──────────────────────────────────────────────────────────────────────────────
# CIVIC LENZ — Environment Variables Template
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env, .env.local, or .env.staging to Git.
# ──────────────────────────────────────────────────────────────────────────────

# SQLite Local Database (prototype / development only)
# For Netlify production, Prisma reads from the bundled db/custom.db file.
DATABASE_URL="file:../db/custom.db"

# ── Groq API (Markus Civic AI Assistant) ──────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# ── Supabase (PostgreSQL — staging or production) ─────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# !! SERVER-SIDE ONLY — Never expose this in the browser or in NEXT_PUBLIC_ vars
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# ── Optional ──────────────────────────────────────────────────────────────────
# Trusted server-to-server administrative operations
ADMIN_SECRET_KEY="your-admin-secret-key-here"
